# Ghostty — symlinked to ~/.config/ghostty/config by setup.sh
# Reload inside Ghostty with cmd+shift+, (macOS). Docs: `ghostty +show-config --default --docs`
# Theme matches the rest of the toolchain (tmux, vim/nvim, bat, delta, k9s, starship).

# --- look ------------------------------------------------------------------
theme = catppuccin-mocha
font-family = "JetBrainsMono Nerd Font"
font-size = 15
font-thicken = true
adjust-cell-height = 10%
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
unfocused-split-opacity = 0.85
macos-titlebar-style = tabs
window-save-state = always

# --- behaviour -------------------------------------------------------------
shell-integration = zsh
shell-integration-features = cursor,sudo,title
copy-on-select = clipboard
clipboard-paste-protection = true
confirm-close-surface = false
scrollback-limit = 20000000
macos-option-as-alt = true
auto-update = check

# --- keybindings -----------------------------------------------------------
# tmux handles panes/windows inside a session (prefix ctrl+space); these are
# the few Ghostty-level ones worth having, kept off tmux's keys.
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+t=new_tab
keybind = cmd+shift+[=previous_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+k=clear_screen
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size
keybind = cmd+shift+,=reload_config
# drop-down terminal from anywhere (global hotkey): cmd+`
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1
