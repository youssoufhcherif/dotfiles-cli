# Template for ~/.env — copy to ~/.env and fill in. ~/.env is sourced by
# ~/.zshrc and is NEVER committed (it is not in this repo and never should be).
#   cp ~/dotfiles-cli/env.example ~/.env && chmod 600 ~/.env
#
# Prefer the gh CLI for GitHub (git credentials come from `gh auth login`,
# see git/config); these variables are for tools that read them from the
# environment (npm, CI scripts, SDKs).

# GitHub personal access tokens, one per organisation
export GITHUB_TOKEN=
export ME_GITHUB_PAT=
export BIOGROUP_GITHUB_PAT=
export KLIKSANTE_GITHUB_TOKEN=
export DDEV_GITHUB_PAT=

# npm registry (npm.pkg.github.com)
export NPM_TOKEN=

# Anthropic API
export ANTHROPIC_KEY=
